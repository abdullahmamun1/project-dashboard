# Prisma Postgres direct TCP connection string (postgres://..., not prisma+postgres://)
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# At least 32 characters. Must match the client's JWT_SECRET (used by its route guard).
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma-separated allowed CORS origins
CLIENT_URL="http://localhost:3000"
PORT=4000

# Seeded mentor account
MENTOR_NAME="Mentor"
MENTOR_EMAIL="mentor@example.com"
MENTOR_PASSWORD="Mentor@12345"
